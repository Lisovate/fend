# macOS
.DS_Store

# Local Claude Code state
.claude/settings.local.json

# Swift build artifacts
swift/.build/
swift/Package.resolved

# Rust build artifacts
fendd/target/
linux/target/

# Node
node_modules/
.tmp/

# Built native binaries staged for npm publish (produced by scripts/build-binary.sh)
packages/*/bin/fend
packages/*/libexec/fendd

# Fend runtime (downloaded, not committed)
# These are generated by scripts/prepare-runtime.sh
# ~/.fend/runtime/ is the actual location, but just in case:
runtime/
