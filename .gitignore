# macOS
.DS_Store
.AppleDouble
.LSOverride

# Other OS
Thumbs.db
Desktop.ini

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# Local Claude Code state
.claude/settings.local.json

# Env files
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Swift build artifacts
.build/
*.xcodeproj/
swift/Package.resolved

# Rust build artifacts
target/
**/*.rs.bk

# Node
node_modules/

# Tests / coverage
coverage/
*.lcov

# Temporary
.tmp/

# Built native binaries staged for npm publish
# (produced by scripts/build-binary.sh, scripts/build-linux-binary.sh)
packages/*/bin/fend
packages/*/libexec/fendd

# Local Fend state
# The real default is ~/.fend/, but keep repo-local test runs out of git too.
.fend/
runtime/
